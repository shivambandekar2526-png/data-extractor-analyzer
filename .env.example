# ==========================================
# Data Extractor AI - Environment Variables
# ==========================================

# Supabase Cloud Storage & Database credentials
# (Required on Render to access all departments, Excel datasets, and PDFs)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_secret_or_service_key_here
SUPABASE_STORAGE_BUCKET=departments_data

# Python Runtime on Render
PYTHON_VERSION=3.11.9

# Server Port (Render sets this dynamically)
PORT=5001
HOST=0.0.0.0
